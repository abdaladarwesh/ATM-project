{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build SQLite Project",
            "type": "shell",
            "command": "cl",
            "args": [
                "Source.cpp",
                "sqlite3.c", 
                "/I.",
                "/EHsc",
                "/std:c++17"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        }
    ]
}